#CRAWL4AI_LLM_INSTRUCTION="提取此網頁的主要內容，移除導航欄、頁尾、廣告等無關內容。"

CRAWL4AI_VERBOSE=true


# 多個正則用 ||| 分隔
SCRAPER_CONTENT_BLACKLIST_PATTERNS_STR=^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}$|||^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\s*知道了$

