# Application Settings
APP_NAME=Chatbot RAG API
APP_VERSION=0.1.0
DEBUG=False

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=True

# CORS Settings (comma-separated)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:8000

# Logging Settings
LOG_LEVEL=INFO
LOG_TO_CONSOLE=True
LOG_TO_FILE=True
LOG_FILE_PATH=logs/app.log
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_COLORIZE_FILE=True

# Performance Settings
WORKERS=4
MAX_CONNECTIONS=1000
BACKLOG=2048
KEEPALIVE_TIMEOUT=65

# Qdrant Vector Database Settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333

# OpenAI Compatible LLM Settings (LMStudio)
 OPENAI_API_BASE=http://192.168.50.152:1234/v1
 OPENAI_API_KEY=sk-tkjHQa-QHX3sA6gjEEWF0Q
 EMBEDDING_MODEL=text-embedding-embeddinggemma-300m-qat
 EMBEDDING_DIMENSION=768
 CHAT_MODEL=openai/gpt-oss-20b
 QDRANT_COLLECTION_NAME=ptch_documents

# Document Processing Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_DOCS_PATH=rag_test_data/docs
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=2000

# Input Validation & Security
ENABLE_INPUT_GUARD=True
MAX_QUESTION_LENGTH=1000
ENABLE_RELEVANCE_CHECK=True
ENABLE_INJECTION_DETECTION=True

LLM_STREAM_DEBUG=False

LANGFUSE_SECRET_KEY="sk-lf-573148e1-c5fa-45c7-b1bf-d3a1415d8839"
LANGFUSE_PUBLIC_KEY="pk-lf-765947d5-2c70-4aee-a99c-5e6a2931d47c"
LANGFUSE_BASE_URL="http://192.168.50.152:3000"



LANGFUSE_PROMPT_ENABLED=True
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL=300

semantic_cache_enabled=false

# LLM 並發控制
LLM_MAX_CONCURRENT_DEFAULT=10
LLM_MAX_CONCURRENT_CHAT=20
LLM_MAX_CONCURRENT_RESPONSES=16
LLM_MAX_CONCURRENT_EMBEDDING=30
LLM_REQUEST_TIMEOUT=60.0

# 優先級排序（可選）
LLM_PRIORITY_ENABLED=false
LLM_PRIORITY_STARVATION_THRESHOLD=5.0

# 遙測採樣
LANGFUSE_SAMPLE_RATE=1

# 啟用 LLM 提取（預設關閉）
#CRAWL4AI_LLM_EXTRACTION_ENABLED=true

